# MongoDB (cloud-hosted, e.g. MongoDB Atlas)
MONGO_URI=
# API
PORT=
NODE_ENV=

# Frontend URL (for CORS)
CLIENT_URL=

# Testnet
CHAIN_ID=

# Pinata (https://app.pinata.cloud)
PINATA_JWT=
PINATA_GATEWAY=

# ── On-chain registry (Phase 2) ───────────────────────────────────────────────
# Avalanche Fuji HTTP RPC (reads + cron getLogs). Public default works.
AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
# Optional WebSocket RPC for the live event listener. If unset, the 60s cron is the only sync path.
AVALANCHE_FUJI_WS=
# Deployed ModelRegistry address. If unset, falls back to packages/contracts/deployments/*.json.
MODEL_REGISTRY_ADDRESS=
# Optional: block the contract was deployed at, so the cron / full-scan can backfill from there.
MODEL_REGISTRY_DEPLOY_BLOCK=

# ── E2E seed pipeline ────────────────────────────────────────────────────────
# Deterministic wallet source for seeded model owners.
SEED_MNEMONIC=
# Treasury key used only by seed:fund to top up derived wallets.
SEED_TREASURY_PRIVATE_KEY=
SEED_MODEL_COUNT=25
SEED_API_URL=http://localhost:4000
SEED_CLIENT_URL=http://localhost:3000
# Defaults to MODEL_REGISTRY_ADDRESS or the Fuji deployment in @handshake/contracts.
SEED_REGISTRY_ADDRESS=
# Defaults to AVALANCHE_FUJI_RPC or Fuji's public RPC.
SEED_RPC_URL=
# Optional HF token for rate limits or gated metadata access.
SEED_HF_TOKEN=
SEED_HF_MAX_BYTES_PER_MODEL=5000000
SEED_CONCURRENCY=3
