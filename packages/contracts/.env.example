# Avalanche Fuji testnet RPC (HTTP). Public default works for read/deploy.
AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# Deployer EOA private key (NO 0x prefix needed; with or without is accepted).
# Must hold Fuji AVAX (faucet: https://faucet.avax.network/). NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=

# Snowtrace (Routescan) API key for source verification. Fuji verification on
# Routescan accepts the literal "verifyContract" key, but set your own if you have one.
SNOWTRACE_API_KEY=
